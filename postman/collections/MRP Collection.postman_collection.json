	{
      "name": "Media",
      "item": [
        {
          "name": "Create Media",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "var json = pm.response.json();",
                  "if (json.id) pm.environment.set(\"mediaId\", json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Godfather Part II\",\n  \"description\": \"Fortsetzung der Corleone-Saga über Macht, Familie und den Aufstieg von Michael sowie die Vorgeschichte von Vito.\",\n  \"mediaType\": \"Movie\",\n  \"releaseYear\": 1974,\n  \"ageRestriction\": 16,\n  \"genres\": [\"Crime\", \"Drama\", \"Gangster\", \"Epic\"]\n}"
            },
            "url": {
              "raw": "{{baseURL}}/media",
              "host": ["{{baseURL}}"],
              "path": ["media"]
            }
          }
        },
