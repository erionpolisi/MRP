  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Successful POST request\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) pm.environment.set(\"authToken\", jsonData.token);",
                  "if (jsonData.userId) pm.environment.set(\"userId\", jsonData.userId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n\"username\": \"erion\",\n\"fullname\": \"Erion Polisi\",\n\"email\": \"er.polisi@gmail.com\",\n\"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/users/register",
              "host": ["{{baseURL}}"],
              "path": ["users", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Successful POST request\", function () {",
