          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "e7d027fe-e4f3-417c-99eb-ea1b3d94b4e5",
                "exec": [
                  "pm.test(\"Successful POST request\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) pm.environment.set(\"authToken\", jsonData.token);",
                  "if (jsonData.userId) pm.environment.set(\"userId\", jsonData.userId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "id": "cd9a5daf-4f90-46d8-8666-99131e7e6799",
